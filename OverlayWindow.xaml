<Window x:Class="BO1Tracker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BO1 Overlay"
        Width="560" Height="160"
        MinWidth="200" MinHeight="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Closing="OverlayWindow_Closing">

    <Window.Resources>
        <Style x:Key="CtrlBtn" TargetType="Button">
            <Setter Property="Background"      Value="#22FFFFFF"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeBtn" TargetType="Button">
            <Setter Property="Background"      Value="#33FFFFFF"/>
            <Setter Property="Foreground"      Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="9"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <StackPanel>

            <!-- Barre de contrôle (toujours visible, seule zone de déplacement de la fenêtre).
                 Fond quasi invisible (alpha=1) et non pas totalement Transparent : sous Windows,
                 une fenêtre "AllowsTransparency" laisse passer les clics à travers un pixel
                 d'alpha 0, donc un fond réellement transparent empêcherait tout déplacement. -->
            <Border x:Name="HeaderBarBorder" Background="#01000000" CornerRadius="8,8,0,0" Padding="10,6"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <DockPanel>
                    <!-- Sélecteur de mode -->
                    <StackPanel x:Name="HeaderControlsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ModeBO1Btn" Content="BO1" Style="{StaticResource ModeBtn}" Margin="0,0,4,0" Click="ModeBO1_Click"/>
                        <Button x:Name="ModeBO2Btn" Content="BO2" Style="{StaticResource ModeBtn}" Margin="0,0,4,0" Click="ModeBO2_Click"/>
                        <Button x:Name="ModeBoxBtn" Content="BOÎTE"     Style="{StaticResource ModeBtn}" Click="ModeBox_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="HeaderRightControlsPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RoundsVisibilityBtn" Content="MANCHES" Style="{StaticResource CtrlBtn}" Margin="0,0,4,0" Click="RoundsVisibilityButton_Click"
                                ToolTip="Afficher/masquer les manches spéciales dans l'overlay"/>
                        <Button x:Name="HordesVisibilityBtn" Content="HORDES" Style="{StaticResource CtrlBtn}" Margin="0,0,4,0" Click="HordesVisibilityButton_Click"
                                ToolTip="Afficher/masquer les hordes dans l'overlay"/>
                        <Button x:Name="BonusTypesBtn" Content="BONUS" Style="{StaticResource CtrlBtn}" Margin="0,0,4,0" Click="BonusTypesButton_Click"
                                ToolTip="Activer/désactiver Carpenter, Fire Sale, Death Machine, etc. directement depuis l'overlay"/>
                        <Button x:Name="OpaqueBtn" Content="OPAQUE" Style="{StaticResource CtrlBtn}" Margin="0,0,4,0" Click="OpaqueButton_Click"
                                ToolTip="Bascule entre fond totalement transparent (pour OBS Window Capture) et fond plein (pour utiliser la fenêtre normalement, sans OBS)"/>
                        <Button x:Name="TopBtn"  Content="FOND"   Style="{StaticResource CtrlBtn}" Margin="0,0,4,0" Click="TopButton_Click"/>
                        <Button x:Name="LockBtn" Content="LOCK"   Style="{StaticResource CtrlBtn}" Margin="0,0,4,0" Click="LockButton_Click"/>
                        <Button                  Content="✕"      Style="{StaticResource CtrlBtn}" Foreground="#FF6B6B" Margin="0,0,4,0" Click="CloseButton_Click"/>
                    </StackPanel>
                    <Button x:Name="CollapseBtn" Content="▲" Style="{StaticResource CtrlBtn}"
                            DockPanel.Dock="Right" HorizontalAlignment="Right"
                            ToolTip="Réduire/afficher les boutons (ne garde que les bonus à l'écran)"
                            Click="CollapseButton_Click"/>
                </DockPanel>
            </Border>

            <!-- Contenu -->
            <Border x:Name="ContentBarBorder" Background="Transparent" CornerRadius="0,0,8,8" Padding="12,10">
                <StackPanel>
                    <!-- Activer/désactiver les bonus optionnels (Carpenter, Fire Sale, ...) -->
                    <WrapPanel x:Name="BonusTypesPanel" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
                    <TextBlock x:Name="EmptyText"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#444444" Visibility="Collapsed"/>

                    <!-- Manches spéciales de la map active (BO1 dog rounds, Die Rise, Mob) -->
                    <StackPanel x:Name="RoundSectionPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed"/>

                    <!-- Zombies par manche (nombre de joueurs + manche choisis manuellement) -->
                    <StackPanel x:Name="ZombiesSectionPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
