<Window x:Class="BO1Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Black Ops Tracker"
        Width="860" Height="700"
        MinWidth="640" MinHeight="520"
        Background="{StaticResource BrushBgMain}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="Margin"     Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />   <!-- 0  Header + sep -->
        <RowDefinition Height="*" />      <!-- 1  Content panels -->
    </Grid.RowDefinitions>

    <!-- ══ HEADER PARTAGÉ ══ -->
    <Grid Grid.Row="0" Margin="24,20,24,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="BLACK OPS TRACKER"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center" />
                <!-- Sélecteur BO1 / BO2 -->
                <Border Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="6"
                        Margin="14,0,0,0" Padding="3"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="Bo1TabButton"
                                      Content="BO1"
                                      IsChecked="True"
                                      FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                      Padding="14,5"
                                      Background="{StaticResource BrushAccentDark}"
                                      Foreground="{StaticResource BrushAccentLight}"
                                      BorderBrush="{StaticResource BrushAccent}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      Click="Bo1TabButton_Click" />
                        <ToggleButton x:Name="Bo2TabButton"
                                      Content="BO2"
                                      IsChecked="False"
                                      FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                      Padding="14,5"
                                      Margin="4,0,0,0"
                                      Background="{StaticResource BrushBgCard}"
                                      Foreground="{StaticResource BrushTextSecondary}"
                                      BorderBrush="{StaticResource BrushBorder}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      Click="Bo2TabButton_Click" />
                        <ToggleButton x:Name="MultiTabButton"
                                      Content="MULTI"
                                      IsChecked="False"
                                      FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                      Padding="14,5"
                                      Margin="4,0,0,0"
                                      Background="{StaticResource BrushBgCard}"
                                      Foreground="{StaticResource BrushTextSecondary}"
                                      BorderBrush="{StaticResource BrushBorder}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      Click="MultiTabButton_Click" />
                        <ToggleButton x:Name="TwitchTabButton"
                                      Content="TWITCH"
                                      IsChecked="False"
                                      FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                      Padding="14,5"
                                      Margin="4,0,0,0"
                                      Background="{StaticResource BrushBgCard}"
                                      Foreground="{StaticResource BrushTextSecondary}"
                                      BorderBrush="{StaticResource BrushBorder}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      Click="TwitchTabButton_Click" />
                        <ToggleButton x:Name="ResetTrackerTabButton"
                                      Content="RESET"
                                      IsChecked="False"
                                      FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                      Padding="14,5"
                                      Margin="4,0,0,0"
                                      Background="{StaticResource BrushBgCard}"
                                      Foreground="{StaticResource BrushTextSecondary}"
                                      BorderBrush="{StaticResource BrushBorder}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      Click="ResetTrackerTabButton_Click" />
                        <ToggleButton x:Name="ZombiesTabButton"
                                      Content="ZOMBIES"
                                      IsChecked="False"
                                      FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                      Padding="14,5"
                                      Margin="4,0,0,0"
                                      Background="{StaticResource BrushBgCard}"
                                      Foreground="{StaticResource BrushTextSecondary}"
                                      BorderBrush="{StaticResource BrushBorder}"
                                      BorderThickness="1"
                                      Cursor="Hand"
                                      Click="ZombiesTabButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ExportTxtButton"
                        Content="&#x1F4C4; ENREGISTRER"
                        VerticalAlignment="Center"
                        FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Background="{StaticResource BrushAccentDark}"
                        Foreground="{StaticResource BrushAccentLight}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="ExportTxtButton_Click" />
                <Button x:Name="ResetAllButton"
                        Content="&#x1F5D1; TOUT EFFACER"
                        VerticalAlignment="Center"
                        FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                        Padding="14,8"
                        Background="#3D1010"
                        Foreground="#FF6B6B"
                        BorderBrush="#C0392B"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="ResetAllButton_Click" />
            </StackPanel>
        </Grid>
        <Rectangle Grid.Row="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,0" />
    </Grid>

    <!-- ══ CONTENU BO1 ══ -->
    <ScrollViewer x:Name="Bo1Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="24,10,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0  Label map -->
            <RowDefinition Height="Auto" />   <!-- 1  Boutons maps -->

            <!-- ── MANCHES SPÉCIALES ── -->
            <RowDefinition Height="Auto" />   <!-- 2  Sep spéciale -->
            <RowDefinition Height="Auto" />   <!-- 3  Label spéciale -->
            <RowDefinition Height="Auto" />   <!-- 4  Contrôles spéciale -->
            <RowDefinition Height="Auto" />   <!-- 5  Historique spéciale -->

            <RowDefinition Height="Auto" />   <!-- 6  Sep boîte -->
            <RowDefinition Height="Auto" />   <!-- 7  Header boîte (pliable) -->
            <RowDefinition Height="Auto" />   <!-- 8  Contenu boîte (pliable) -->

            <RowDefinition Height="Auto" />   <!-- 9  Sep bonus -->
            <RowDefinition Height="Auto" />   <!-- 10 Header bonus (pliable) -->
            <RowDefinition Height="Auto" />   <!-- 11 Contenu bonus (pliable, inclut ACTIVER/DÉSACTIVER) -->
        </Grid.RowDefinitions>

        <!-- En-tête CHOIX DE LA MAP cliquable -->
        <Grid Grid.Row="0" Margin="0,0,0,8" Cursor="Hand"
              MouseLeftButtonUp="MapHeader_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CHOIX DE LA MAP"
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextMuted}"
                           VerticalAlignment="Center" />
                <!-- Map sélectionnée inline (visible quand collapsed) -->
                <Border x:Name="MapSelectedInline"
                        Margin="10,0,0,0" Padding="8,2"
                        CornerRadius="4"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="MapSelectedInlineText"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource BrushAccentLight}" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="MapChevron"
                       Text="▼"
                       FontFamily="Consolas" FontSize="10"
                       Foreground="{StaticResource BrushTextMuted}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Boutons maps (pliable) -->
        <WrapPanel x:Name="MapButtonsPanel" Grid.Row="1"
                   Orientation="Horizontal" Margin="0,0,0,16" />

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MANCHES SPÉCIALES                                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!-- Séparateur manches spéciales -->
        <Rectangle x:Name="DogSeparator" Grid.Row="2" Fill="{StaticResource BrushBorder}" Margin="0,0,0,16" />

        <!-- Label manches spéciales -->
        <TextBlock x:Name="DogLabel" Grid.Row="3" Text="MANCHES SPÉCIALES"
                   Style="{StaticResource SectionLabelStyle}" />

        <!-- Contrôles manches spéciales -->
        <StackPanel x:Name="DogControlsPanel" Grid.Row="4" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Première manche :"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="Consolas" FontSize="13"
                           Margin="0,0,10,0" />
                <TextBox x:Name="DogRoundInput"
                         Width="60" Height="32"
                         FontFamily="Consolas" FontSize="14"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         Background="{StaticResource BrushBgCard}"
                         Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorder}"
                         BorderThickness="1"
                         Margin="0,0,10,0"
                         MaxLength="3"
                         PreviewTextInput="DogRoundInput_PreviewTextInput" />
                <Button x:Name="SetDogRoundButton"
                        Content="ENREGISTRER"
                        Style="{StaticResource ResetButtonStyle}"
                        Margin="0,0,10,0"
                        Click="SetDogRoundButton_Click" />
                <Button x:Name="ResetDogRoundsButton"
                        Content="EFFACER"
                        Style="{StaticResource ResetDangerButtonStyle}"
                        Click="ResetDogRoundsButton_Click" />
            </StackPanel>

            <StackPanel x:Name="DogNextRoundPanel" Orientation="Horizontal"
                        Visibility="Collapsed" Margin="0,0,0,0">
                <TextBlock Text="Prochaine manche :"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="Consolas" FontSize="13"
                           Margin="0,0,10,0" />
                <Border x:Name="DogNext4Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,8,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="DogNext4Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+4 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DogNext4Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="DogNext5Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,0,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="DogNext5Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+5 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DogNext5Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Historique manches spéciales -->
        <Border x:Name="DogHistoryBox"
                Grid.Row="5"
                Background="{StaticResource BrushBgHistory}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="16,14" Margin="0,0,0,24"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="HISTORIQUE DES MANCHES SPÉCIALES"
                           Style="{StaticResource SectionLabelStyle}" />
                <WrapPanel x:Name="DogHistoryPanel" Orientation="Horizontal" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TRACKER CYCLE DE BOÎTE (pliable)                            -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <Rectangle x:Name="BoxSeparator" Grid.Row="6"
                   Fill="{StaticResource BrushBorder}"
                   Margin="0,0,0,16" Visibility="Collapsed" />

        <Grid x:Name="BoxHeaderGrid" Grid.Row="7" Margin="0,0,0,12"
              Cursor="Hand" Visibility="Collapsed"
              MouseLeftButtonUp="BoxHeader_Click">
            <DockPanel>
                <TextBlock x:Name="MapTitleText"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BoxChevron"
                           Text="▼"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="{StaticResource BrushTextMuted}"
                           DockPanel.Dock="Right"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <Button x:Name="OverlayButton"
                        DockPanel.Dock="Right"
                        Content="📺  OVERLAY OBS"
                        Style="{StaticResource ResetButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="OverlayButton_Click"
                        ToolTip="Ouvre une fenêtre transparente à capturer dans OBS (Window Capture)"/>
            </DockPanel>
        </Grid>

        <StackPanel x:Name="BoxContentPanel" Grid.Row="8" Visibility="Collapsed">
            <TextBlock Text="TRACKER CYCLE DE BOÎTE"
                       Style="{StaticResource SectionLabelStyle}" Margin="0" />
            <TextBlock Text="CLIQUE SUR LES EMPLACEMENTS AU FUR ET À MESURE QUE LA BOÎTE SE DÉPLACE"
                       Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,12" />

            <WrapPanel x:Name="BoxLocationsPanel"
                       Orientation="Horizontal"
                       Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="ResetBoxCycleButton"
                        Content="REINITIALISER LE CYCLE BOÎTE"
                        Style="{StaticResource ResetButtonStyle}"
                        Margin="0,0,10,0"
                        Click="ResetBoxCycleButton_Click" />
                <Button x:Name="ResetBoxHistoryButton"
                        Content="EFFACER L'HISTORIQUE BOÎTE"
                        Style="{StaticResource ResetDangerButtonStyle}"
                        Click="ResetBoxHistoryButton_Click" />
            </StackPanel>

            <Border x:Name="BoxHistoryBox"
                    Background="{StaticResource BrushBgHistory}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="16,14" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="HISTORIQUE DES CYCLES BOÎTE"
                               Style="{StaticResource SectionLabelStyle}" />
                    <StackPanel x:Name="BoxHistoryPanel" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TRACKER CYCLE DE BONUS (pliable)                            -->
        <!-- inclut ACTIVER / DÉSACTIVER DES BONUS                       -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <Rectangle x:Name="BonusSeparator" Grid.Row="9"
                   Fill="{StaticResource BrushBorder}"
                   Margin="0,0,0,16" />

        <Grid x:Name="BonusHeaderGrid" Grid.Row="10" Margin="0,0,0,12"
              Cursor="Hand"
              MouseLeftButtonUp="BonusHeader_Click">
            <DockPanel>
                <TextBlock Text="TRACKER CYCLE DE BONUS"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BonusChevron"
                           Text="▼"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="{StaticResource BrushTextMuted}"
                           DockPanel.Dock="Right"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <Button x:Name="OverlayBonusButton"
                        DockPanel.Dock="Right"
                        Content="📺  OVERLAY OBS"
                        Style="{StaticResource ResetButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="OverlayBonusButton_Click"
                        ToolTip="Ouvre l'overlay OBS en mode Bonus BO1"/>
            </DockPanel>
        </Grid>

        <StackPanel x:Name="BonusContentPanel" Grid.Row="11">
            <TextBlock Text="ACTIVER / DESACTIVER DES BONUS"
                       Style="{StaticResource SectionLabelStyle}" />

            <WrapPanel x:Name="ToggleButtonsPanel"
                       Orientation="Horizontal" Margin="0,0,0,16" />

            <Rectangle Fill="{StaticResource BrushBorder}" Margin="0,0,0,16" Height="1" />

            <TextBlock Text="CLIQUE SUR LES BONUS AU FUR ET À MESURE QU'ILS TOMBENT"
                       Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,16" />

            <WrapPanel x:Name="DropsPanel"
                       Orientation="Horizontal"
                       Margin="0,0,0,16" />

            <StackPanel x:Name="ResetButtonsPanel" Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="ResetCycleButton"
                        Content="REINITIALISER LE CYCLE BONUS"
                        Style="{StaticResource ResetButtonStyle}"
                        Margin="0,0,10,0"
                        Click="ResetCycleButton_Click" />
                <Button x:Name="ResetHistoryButton"
                        Content="EFFACER L'HISTORIQUE BONUS"
                        Style="{StaticResource ResetDangerButtonStyle}"
                        Click="ResetHistoryButton_Click" />
            </StackPanel>

            <Border x:Name="HistoryBox"
                    Background="{StaticResource BrushBgHistory}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="16,14" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="HISTORIQUE DES CYCLES BONUS"
                               Style="{StaticResource SectionLabelStyle}" />
                    <StackPanel x:Name="HistoryPanel" />
                </StackPanel>
            </Border>
        </StackPanel>

      </Grid>
    </ScrollViewer>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!-- PANNEAU BO2                                                    -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <ScrollViewer x:Name="Bo2Panel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0  Label map BO2 -->
            <RowDefinition Height="Auto" />   <!-- 1  Boutons maps BO2 -->
            <!-- ── MANCHES SPÉCIALES (Die Rise uniquement) ── -->
            <RowDefinition Height="Auto" />   <!-- 2  Sep manches spéciales -->
            <RowDefinition Height="Auto" />   <!-- 3  Label manches spéciales -->
            <RowDefinition Height="Auto" />   <!-- 4  Contrôles manches spéciales -->
            <RowDefinition Height="Auto" />   <!-- 5  Historique manches spéciales -->
            <!-- ── MANCHES SPÉCIALES (Mob of the Dead uniquement) ── -->
            <RowDefinition Height="Auto" />   <!-- 6  Sep manches spéciales Mob -->
            <RowDefinition Height="Auto" />   <!-- 7  Label manches spéciales Mob -->
            <RowDefinition Height="Auto" />   <!-- 8  Contrôles manches spéciales Mob -->
            <RowDefinition Height="Auto" />   <!-- 9  Historique manches spéciales Mob -->
            <!-- ── MANCHES SPÉCIALES (Origins, Panzers uniquement) ── -->
            <RowDefinition Height="Auto" />   <!-- 10 Sep manches spéciales Panzer -->
            <RowDefinition Height="Auto" />   <!-- 11 Label manches spéciales Panzer -->
            <RowDefinition Height="Auto" />   <!-- 12 Contrôles manches spéciales Panzer -->
            <RowDefinition Height="Auto" />   <!-- 13 Historique manches spéciales Panzer -->
            <!-- ── BONUS DES TANKS (Origins uniquement, 3 onglets manuels) ── -->
            <RowDefinition Height="Auto" />   <!-- 14 Sep tanks -->
            <RowDefinition Height="Auto" />   <!-- 15 Label + onglets tanks -->
            <RowDefinition Height="Auto" />   <!-- 16 Contrôles + historique tank actif -->
            <!-- ── TOGGLE BONUS BO2 ── -->
            <RowDefinition Height="Auto" />   <!-- 17 Sep options -->
            <RowDefinition Height="Auto" />   <!-- 18 Label toggle bonus -->
            <RowDefinition Height="Auto" />   <!-- 19 Toggle buttons -->
            <!-- ── TRACKER BONUS BO2 ── -->
            <RowDefinition Height="Auto" />   <!-- 20 Sep bonus -->
            <RowDefinition Height="Auto" />   <!-- 21 Labels bonus -->
            <RowDefinition Height="Auto" />   <!-- 22 Drops panel -->
            <RowDefinition Height="Auto" />   <!-- 23 Reset buttons bonus -->
            <RowDefinition Height="Auto" />   <!-- 24 Historique bonus -->
        </Grid.RowDefinitions>

        <!-- En-tête CHOIX DE LA MAP BO2 -->
        <TextBlock Grid.Row="0" Text="CHOIX DE LA MAP — BLACK OPS 2"
                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextMuted}"
                   Margin="0,0,0,10" />

        <!-- Boutons maps BO2 -->
        <WrapPanel x:Name="Bo2MapButtonsPanel" Grid.Row="1"
                   Orientation="Horizontal" Margin="0,0,0,16" />

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MANCHES SPÉCIALES — DIE RISE UNIQUEMENT                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <Rectangle x:Name="Bo2DogSeparator" Grid.Row="2"
                   Fill="{StaticResource BrushBorder}" Margin="0,0,0,16" Visibility="Collapsed" />

        <TextBlock x:Name="Bo2DogLabel" Grid.Row="3" Text="MANCHES SPÉCIALES"
                   Style="{StaticResource SectionLabelStyle}" Visibility="Collapsed" />

        <StackPanel x:Name="Bo2DogControlsPanel" Grid.Row="4" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Première manche :"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="Consolas" FontSize="13"
                           Margin="0,0,10,0" />
                <TextBox x:Name="Bo2DogRoundInput"
                         Width="60" Height="32"
                         FontFamily="Consolas" FontSize="14"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         Background="{StaticResource BrushBgCard}"
                         Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorder}"
                         BorderThickness="1"
                         Margin="0,0,10,0"
                         MaxLength="3"
                         PreviewTextInput="Bo2DogRoundInput_PreviewTextInput" />
                <Button x:Name="SetBo2DogRoundButton"
                        Content="ENREGISTRER"
                        Style="{StaticResource ResetButtonStyle}"
                        Margin="0,0,10,0"
                        Click="SetBo2DogRoundButton_Click" />
                <Button x:Name="ResetBo2DogRoundsButton"
                        Content="EFFACER"
                        Style="{StaticResource ResetDangerButtonStyle}"
                        Click="ResetBo2DogRoundsButton_Click" />
            </StackPanel>

            <StackPanel x:Name="Bo2DogNextRoundPanel" Orientation="Horizontal"
                        Visibility="Collapsed" Margin="0,0,0,0">
                <TextBlock Text="Prochaine manche :"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="Consolas" FontSize="13"
                           Margin="0,0,10,0" />
                <Border x:Name="Bo2DogNext4Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,8,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="Bo2DogNext4Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+4 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Bo2DogNext4Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="Bo2DogNext5Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,0,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="Bo2DogNext5Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+5 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Bo2DogNext5Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border x:Name="Bo2DogHistoryBox"
                Grid.Row="5"
                Background="{StaticResource BrushBgHistory}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="16,14" Margin="0,0,0,24"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="HISTORIQUE DES MANCHES SPÉCIALES"
                           Style="{StaticResource SectionLabelStyle}" />
                <WrapPanel x:Name="Bo2DogHistoryPanel" Orientation="Horizontal" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
