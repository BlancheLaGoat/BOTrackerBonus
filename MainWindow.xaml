            <StackPanel x:Name="Bo2MobNextRoundPanel" Orientation="Horizontal"
                        Visibility="Collapsed" Margin="0,0,0,0">
                <TextBlock Text="Prochaine manche :"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="Consolas" FontSize="13"
                           Margin="0,0,10,0" />
                <Border x:Name="Bo2MobNext4Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,8,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="Bo2MobNext4Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+4 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Bo2MobNext4Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="Bo2MobNext5Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,8,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="Bo2MobNext5Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+5 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Bo2MobNext5Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="Bo2MobNext6Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,0,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="Bo2MobNext6Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+6 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Bo2MobNext6Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border x:Name="Bo2MobHistoryBox"
                Grid.Row="9"
                Background="{StaticResource BrushBgHistory}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="16,14" Margin="0,0,0,24"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="HISTORIQUE DES MANCHES SPÉCIALES"
                           Style="{StaticResource SectionLabelStyle}" />
                <WrapPanel x:Name="Bo2MobHistoryPanel" Orientation="Horizontal" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MANCHES SPÉCIALES — ORIGINS UNIQUEMENT (PANZERS, +4/+5)     -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <Rectangle x:Name="Bo2PanzerSeparator" Grid.Row="10"
                   Fill="{StaticResource BrushBorder}" Margin="0,0,0,16" Visibility="Collapsed" />

        <TextBlock x:Name="Bo2PanzerLabel" Grid.Row="11" Text="PANZER"
                   Style="{StaticResource SectionLabelStyle}" Visibility="Collapsed" />

        <StackPanel x:Name="Bo2PanzerControlsPanel" Grid.Row="12" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Première manche :"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="Consolas" FontSize="13"
                           Margin="0,0,10,0" />
                <TextBox x:Name="Bo2PanzerRoundInput"
                         Width="60" Height="32"
                         FontFamily="Consolas" FontSize="14"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"
                         Background="{StaticResource BrushBgCard}"
                         Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorder}"
                         BorderThickness="1"
                         Margin="0,0,10,0"
                         MaxLength="3"
                         PreviewTextInput="Bo2PanzerRoundInput_PreviewTextInput" />
                <Button x:Name="SetBo2PanzerRoundButton"
                        Content="ENREGISTRER"
                        Style="{StaticResource ResetButtonStyle}"
                        Margin="0,0,10,0"
                        Click="SetBo2PanzerRoundButton_Click" />
                <Button x:Name="ResetBo2PanzerRoundsButton"
                        Content="EFFACER"
                        Style="{StaticResource ResetDangerButtonStyle}"
                        Click="ResetBo2PanzerRoundsButton_Click" />
            </StackPanel>

            <StackPanel x:Name="Bo2PanzerNextRoundPanel" Orientation="Horizontal"
                        Visibility="Collapsed" Margin="0,0,0,0">
                <TextBlock Text="Prochaine manche :"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="Consolas" FontSize="13"
                           Margin="0,0,10,0" />
                <Border x:Name="Bo2PanzerNext4Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,8,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="Bo2PanzerNext4Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+4 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Bo2PanzerNext4Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="Bo2PanzerNext5Badge"
                        Background="{StaticResource BrushAccentDark}"
                        BorderBrush="{StaticResource BrushAccent}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,6" Margin="0,0,0,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="Bo2PanzerNext5Badge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+5 → " FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Bo2PanzerNext5Text"
                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentLight}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border x:Name="Bo2PanzerHistoryBox"
                Grid.Row="13"
                Background="{StaticResource BrushBgHistory}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="16,14" Margin="0,0,0,24"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="HISTORIQUE PANZER"
                           Style="{StaticResource SectionLabelStyle}" />
                <WrapPanel x:Name="Bo2PanzerHistoryPanel" Orientation="Horizontal" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BONUS DES TANKS — ORIGINS UNIQUEMENT (3 colonnes, manuel)   -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <Rectangle x:Name="Bo2TankSeparator" Grid.Row="14"
                   Fill="{StaticResource BrushBorder}" Margin="0,0,0,16" Visibility="Collapsed" />

        <TextBlock x:Name="Bo2TankLabelPanel" Grid.Row="15" Text="BONUS DES TANKS"
                   Style="{StaticResource SectionLabelStyle}" Visibility="Collapsed" />

        <StackPanel x:Name="Bo2TankContentPanel" Orientation="Horizontal" Grid.Row="16" Margin="0,0,0,24" Visibility="Collapsed">

            <!-- Colonne TANK 1 -->
            <Border Background="{StaticResource BrushBgHistory}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,10,0" Width="220" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="TANK 1" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="Bo2Tank1RoundInput"
                                 Width="55" Height="30"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="{StaticResource BrushBgCard}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                 Margin="0,0,6,0" MaxLength="3"
                                 PreviewTextInput="Bo2TankRoundInput_PreviewTextInput" />
                        <Button Content="+" Tag="1" Width="30" Height="30"
                                Style="{StaticResource ResetButtonStyle}" Padding="0"
                                Click="AddBo2TankRoundButton_Click" />
                    </StackPanel>
                    <WrapPanel x:Name="Bo2Tank1HistoryPanel" Orientation="Horizontal" Margin="0,0,0,8" />
                    <TextBlock Text="EFFACER" Tag="1" Foreground="#B05050"
                               FontFamily="Consolas" FontSize="10" Cursor="Hand"
                               MouseLeftButtonUp="ResetBo2TankRoundsButton_Click" />
                </StackPanel>
            </Border>

            <!-- Colonne TANK 2 -->
            <Border Background="{StaticResource BrushBgHistory}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,10,0" Width="220" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="TANK 2" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="Bo2Tank2RoundInput"
                                 Width="55" Height="30"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="{StaticResource BrushBgCard}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                 Margin="0,0,6,0" MaxLength="3"
                                 PreviewTextInput="Bo2TankRoundInput_PreviewTextInput" />
                        <Button Content="+" Tag="2" Width="30" Height="30"
                                Style="{StaticResource ResetButtonStyle}" Padding="0"
                                Click="AddBo2TankRoundButton_Click" />
                    </StackPanel>
                    <WrapPanel x:Name="Bo2Tank2HistoryPanel" Orientation="Horizontal" Margin="0,0,0,8" />
                    <TextBlock Text="EFFACER" Tag="2" Foreground="#B05050"
                               FontFamily="Consolas" FontSize="10" Cursor="Hand"
                               MouseLeftButtonUp="ResetBo2TankRoundsButton_Click" />
                </StackPanel>
            </Border>

            <!-- Colonne TANK 3 -->
            <Border Background="{StaticResource BrushBgHistory}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,10,0" Width="220" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="TANK 3" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="Bo2Tank3RoundInput"
                                 Width="55" Height="30"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="{StaticResource BrushBgCard}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                 Margin="0,0,6,0" MaxLength="3"
                                 PreviewTextInput="Bo2TankRoundInput_PreviewTextInput" />
                        <Button Content="+" Tag="3" Width="30" Height="30"
                                Style="{StaticResource ResetButtonStyle}" Padding="0"
                                Click="AddBo2TankRoundButton_Click" />
                    </StackPanel>
                    <WrapPanel x:Name="Bo2Tank3HistoryPanel" Orientation="Horizontal" Margin="0,0,0,8" />
                    <TextBlock Text="EFFACER" Tag="3" Foreground="#B05050"
                               FontFamily="Consolas" FontSize="10" Cursor="Hand"
                               MouseLeftButtonUp="ResetBo2TankRoundsButton_Click" />
                </StackPanel>
            </Border>

            <!-- Colonne GÉNÉRATEURS -->
            <Border Background="{StaticResource BrushBgHistory}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Width="220" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="GÉNÉRATEURS" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="Bo2GenRoundInput"
                                 Width="55" Height="30"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="{StaticResource BrushBgCard}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                 Margin="0,0,6,0" MaxLength="3"
                                 PreviewTextInput="Bo2TankRoundInput_PreviewTextInput" />
                        <Button Content="+" Width="30" Height="30"
                                Style="{StaticResource ResetButtonStyle}" Padding="0"
                                Click="AddBo2GenRoundButton_Click" />
                    </StackPanel>
                    <WrapPanel x:Name="Bo2GenHistoryPanel" Orientation="Horizontal" Margin="0,0,0,8" />
                    <TextBlock Text="EFFACER" Foreground="#B05050"
                               FontFamily="Consolas" FontSize="10" Cursor="Hand"
                               MouseLeftButtonUp="ResetBo2GenRoundsButton_Click" />
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ACTIVER / DÉSACTIVER DES BONUS BO2                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!-- Séparateur options -->
        <Rectangle Grid.Row="17" Fill="{StaticResource BrushBorder}" Margin="0,0,0,16" />

        <!-- Label toggle bonus -->
        <TextBlock Grid.Row="18" Text="ACTIVER / DESACTIVER DES BONUS"
                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextMuted}"
                   Margin="0,0,0,10" />

        <!-- Boutons toggle bonus BO2 -->
        <WrapPanel x:Name="Bo2ToggleButtonsPanel" Grid.Row="19"
                   Orientation="Horizontal" Margin="0,0,0,20" />

        <!-- ══ TRACKER BONUS BO2 ══ -->
        <Rectangle x:Name="Bo2BonusSeparator" Grid.Row="20"
                   Fill="{StaticResource BrushBorder}"
                   Margin="0,0,0,16" Visibility="Collapsed" />

        <StackPanel x:Name="Bo2BonusLabelPanel" Grid.Row="21"
                    Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="Bo2MapTitleText"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
                <Button x:Name="OverlayBo2Button"
                        DockPanel.Dock="Right"
                        Content="📺  OVERLAY OBS"
                        Style="{StaticResource ResetButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="OverlayBo2Button_Click"
                        ToolTip="Ouvre l'overlay OBS en mode Bonus BO2"/>
            </DockPanel>
            <TextBlock Text="TRACKER CYCLE DE BONUS"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}"
                       Margin="0" />
            <TextBlock Text="CLIQUE SUR LES BONUS AU FUR ET À MESURE QU'ILS TOMBENT"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}"
                       Margin="0" />
        </StackPanel>

        <WrapPanel x:Name="Bo2DropsPanel" Grid.Row="22"
                   Orientation="Horizontal"
                   Margin="0,0,0,16" Visibility="Collapsed" />

        <StackPanel x:Name="Bo2ResetButtonsPanel" Grid.Row="23"
                    Orientation="Horizontal"
                    Margin="0,0,0,20" Visibility="Collapsed">
            <Button x:Name="Bo2ResetCycleButton"
                    Content="REINITIALISER LE CYCLE BONUS"
                    Style="{StaticResource ResetButtonStyle}"
                    Margin="0,0,10,0"
                    Click="Bo2ResetCycleButton_Click" />
            <Button x:Name="Bo2ResetHistoryButton"
                    Content="EFFACER L'HISTORIQUE BONUS"
                    Style="{StaticResource ResetDangerButtonStyle}"
                    Click="Bo2ResetHistoryButton_Click" />
        </StackPanel>

        <Border x:Name="Bo2HistoryBox"
                Grid.Row="24"
                Background="{StaticResource BrushBgHistory}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="16,14" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="HISTORIQUE DES CYCLES BONUS"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,0,0,10" />
                <StackPanel x:Name="Bo2HistoryPanel" />
            </StackPanel>
        </Border>

      </Grid>
    </ScrollViewer>

    <!-- ══ CONTENU MULTI ══ -->
    <ScrollViewer x:Name="MultiPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <Grid Margin="24,10,24,20">

        <!-- PANNEAU MULTIJOUEUR -->
        <Border x:Name="MultiPanelBorder"
                Background="#0D1B14"
                BorderBrush="#1D9E75"
                BorderThickness="1" CornerRadius="10"
                Margin="0,0,0,10">
            <StackPanel>
                <!-- En-tête -->
                <Border Padding="16,12" CornerRadius="10">
                    <TextBlock Text="🌐 MULTIJOUEUR (Radmin VPN / Hamachi)"
                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                               Foreground="#1D9E75" VerticalAlignment="Center" />
                </Border>

                <!-- Contenu -->
                <StackPanel x:Name="MultiContent" Margin="16,0,16,14">

                <!-- Statut de connexion -->
                <Border x:Name="MultiStatusBorder"
                        Background="#0A110D"
                        BorderBrush="#1D3A28"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,12">
                    <TextBlock x:Name="MultiStatusText"
                               Text="⚫  Hors ligne — choisissez un mode ci-dessous"
                               FontFamily="Consolas" FontSize="12"
                               Foreground="#6B8C7A" />
                </Border>

                <!-- Pseudo du joueur -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="TON PSEUDO  " FontFamily="Consolas" FontSize="11"
                               FontWeight="Bold" Foreground="#6BAA88"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="PlayerNameBox"
                             Width="160" Height="28"
                             Text=""
                             FontFamily="Consolas" FontSize="12"
                             VerticalContentAlignment="Center"
                             Background="#0D1B14" Foreground="#A8D5BF"
                             BorderBrush="#1D3A28" BorderThickness="1"
                             MaxLength="24" />
                </StackPanel>

                <!-- Liste joueurs connectés (visible hôte uniquement) -->
                <Border x:Name="PlayersListBorder"
                        Background="#0A110D" BorderBrush="#1D3A28"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="JOUEURS CONNECTÉS" FontFamily="Consolas" FontSize="10"
                                   FontWeight="Bold" Foreground="#1D9E75" Margin="0,0,0,6" />
                        <StackPanel x:Name="PlayersListPanel" />
                    </StackPanel>
                </Border>

                <!-- Ligne de contrôles -->
                <StackPanel Orientation="Horizontal">

                    <!-- HÔTE -->
                    <Border Background="#0A1F16" BorderBrush="#1D9E75" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="MOI = HÔTE" FontFamily="Consolas" FontSize="10"
                                       FontWeight="Bold" Foreground="#1D9E75" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HostPortBox"
                                         Width="60" Height="28"
                                         Text="5757"
                                         FontFamily="Consolas" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Background="#0D1B14" Foreground="#A8D5BF"
                                         BorderBrush="#1D3A28" BorderThickness="1"
                                         Margin="0,0,8,0" />
                                <Button x:Name="StartHostButton"
                                        Content="HÉBERGER"
                                        FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                        Padding="12,6"
                                        Background="#1A4A30" Foreground="#A8D5BF"
                                        BorderBrush="#1D9E75" BorderThickness="1"
                                        Cursor="Hand"
                                        Click="StartHostButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- REJOINDRE -->
                    <Border Background="#0A1F16" BorderBrush="#2D5A40" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="REJOINDRE UN HÔTE" FontFamily="Consolas" FontSize="10"
                                       FontWeight="Bold" Foreground="#6BAA88" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="ClientIpBox"
                                         Width="130" Height="28"
                                         Text="192.168.x.x"
                                         FontFamily="Consolas" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Background="#0D1B14" Foreground="#A8D5BF"
                                         BorderBrush="#1D3A28" BorderThickness="1"
                                         Margin="0,0,6,0" />
                                <TextBox x:Name="ClientPortBox"
                                         Width="60" Height="28"
                                         Text="5757"
                                         FontFamily="Consolas" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Background="#0D1B14" Foreground="#A8D5BF"
                                         BorderBrush="#1D3A28" BorderThickness="1"
                                         Margin="0,0,8,0" />
                                <Button x:Name="ConnectClientButton"
                                        Content="REJOINDRE"
                                        FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                        Padding="12,6"
                                        Background="#1A3A28" Foreground="#A8D5BF"
                                        BorderBrush="#2D5A40" BorderThickness="1"
                                        Cursor="Hand"
                                        Click="ConnectClientButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DÉCONNECTER -->
                    <Button x:Name="DisconnectButton"
                            Content="❌ DÉCONNECTER"
                            FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                            Padding="12,6" VerticalAlignment="Bottom"
                            Background="#3D1010" Foreground="#FF6B6B"
                            BorderBrush="#C0392B" BorderThickness="1"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="DisconnectButton_Click" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

      </Grid>
    </ScrollViewer>

    <!-- ══ CONTENU TWITCH ══ -->
    <ScrollViewer x:Name="TwitchPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="24,20,24,20" MaxWidth="640" HorizontalAlignment="Left">

        <TextBlock Text="INTÉGRATION TWITCH / NIGHTBOT"
                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}"
                   Margin="0,0,0,4" />
        <TextBlock Text="Met automatiquement à jour la commande Nightbot avec la liste des manches spéciales à chaque clic ENREGISTRER / +4 / +5."
                   FontFamily="Consolas" FontSize="12"
                   Foreground="{StaticResource BrushTextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20" />

        <Rectangle Fill="{StaticResource BrushBorder}" Height="1" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="TwitchConnectButton"
                    Content="SE CONNECTER À TWITCH"
                    Style="{StaticResource ResetButtonStyle}"
                    Margin="0,0,10,0"
                    Click="TwitchConnectButton_Click" />
            <Button x:Name="TwitchDisconnectButton"
                    Content="DÉCONNECTER"
                    Style="{StaticResource ResetDangerButtonStyle}"
                    Click="TwitchDisconnectButton_Click" />
        </StackPanel>

        <TextBlock x:Name="TwitchStatusText"
                   Text="Non connecté."
                   FontFamily="Consolas" FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource BrushTextSecondary}"
                   Margin="0,0,0,20" />

        <TextBlock Text="RÉGLAGES"
                   Style="{StaticResource SectionLabelStyle}"
                   Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Commande envoyée (met à jour Nightbot via !editcom) :"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontFamily="Consolas" FontSize="12"
                       Margin="0,0,10,0" />
            <TextBox x:Name="TwitchCommandTemplateBox"
                     Width="220" Height="30"
                     FontFamily="Consolas" FontSize="13"
                     VerticalContentAlignment="Center"
                     Background="{StaticResource BrushBgCard}"
                     Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}"
                     BorderThickness="1"
                     LostFocus="TwitchCommandTemplateBox_LostFocus" />
        </StackPanel>

        <CheckBox x:Name="TwitchAutoSendCheck"
                  Content="Envoyer automatiquement dans le chat au clic ENREGISTRER / +4 / +5"
                  Foreground="{StaticResource BrushTextSecondary}"
                  FontFamily="Consolas" FontSize="12"
                  Margin="0,0,0,16"
                  Checked="TwitchAutoSendCheck_Changed"
                  Unchecked="TwitchAutoSendCheck_Changed" />

        <Rectangle Fill="{StaticResource BrushBorder}" Height="1" Margin="0,0,0,16" />

        <TextBlock Text="RÉPONSE DIRECTE (alternative à Nightbot, à ne pas cumuler)"
                   Style="{StaticResource SectionLabelStyle}"
                   Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Commande à écouter dans le chat :"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontFamily="Consolas" FontSize="12"
                       Margin="0,0,10,0" />
            <TextBox x:Name="TwitchListenCommandBox"
                     Width="120" Height="30"
                     FontFamily="Consolas" FontSize="13"
                     VerticalContentAlignment="Center"
                     Background="{StaticResource BrushBgCard}"
                     Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}"
                     BorderThickness="1"
                     LostFocus="TwitchListenCommandBox_LostFocus" />
        </StackPanel>

        <CheckBox x:Name="TwitchListenEnabledCheck"
                  Content="Répondre automatiquement quand un spectateur tape cette commande dans le chat"
                  Foreground="{StaticResource BrushTextSecondary}"
                  FontFamily="Consolas" FontSize="12"
                  Checked="TwitchListenEnabledCheck_Changed"
                  Unchecked="TwitchListenEnabledCheck_Changed" />

      </StackPanel>
    </ScrollViewer>

    <!-- ══ CONTENU RESET TRACKER ══ -->
    <ScrollViewer x:Name="ResetTrackerPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="24,20,24,20" MaxWidth="640" HorizontalAlignment="Left">

        <TextBlock Text="RESET TRACKER (BO1)"
                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}"
                   Margin="0,0,0,4" />
        <TextBlock Text="Estime le temps restant avant un 'reset' de partie à très haute manche (débordement du compteur interne du jeu)."
                   FontFamily="Consolas" FontSize="12"
                   Foreground="{StaticResource BrushTextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <Border Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="8"
                Padding="14,12" Margin="0,0,0,20">
            <TextBlock TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="{StaticResource BrushTextSecondary}">
                <Run Text="⚠ Ce tracker lit deux valeurs en mémoire de BlackOps.exe (jamais d'écriture, aucune modification du jeu). "/>
                <Run Text="Il reste éteint par défaut : active-le uniquement quand tu en as besoin, et désactive-le après pour éviter toute interaction inutile avec le jeu."/>
            </TextBlock>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="ResetTrackerToggleButton"
                    Content="ACTIVER LE TRACKER"
                    Style="{StaticResource ResetButtonStyle}"
                    Click="ResetTrackerToggleButton_Click" />
        </StackPanel>

        <Border x:Name="ResetTrackerStatsBox"
                Background="{StaticResource BrushBgHistory}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="16,14"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ResetTrackerStatusText"
                           Text="En attente de BlackOps.exe ou de Plutonium..."
                           FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentLight}"
                           Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Level time (ticks) :" Foreground="{StaticResource BrushTextSecondary}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ResetTrackerLevelTimeText" Grid.Row="0" Grid.Column="1" Text="—" Foreground="{StaticResource BrushTextPrimary}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Entités sur la map :" Foreground="{StaticResource BrushTextSecondary}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ResetTrackerEntityCountText" Grid.Row="1" Grid.Column="1" Text="—" Foreground="{StaticResource BrushTextPrimary}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Snapshot (dernière minute) :" Foreground="{StaticResource BrushTextSecondary}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ResetTrackerSnapshotText" Grid.Row="2" Grid.Column="1" Text="—" Foreground="{StaticResource BrushTextPrimary}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Temps de session :" Foreground="{StaticResource BrushTextSecondary}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ResetTrackerSessionTimeText" Grid.Row="3" Grid.Column="1" Text="—" Foreground="{StaticResource BrushTextPrimary}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Temps avant reset (est.) :" Foreground="{StaticResource BrushTextSecondary}" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock x:Name="ResetTrackerEstimateText" Grid.Row="4" Grid.Column="1" Text="—" Foreground="{StaticResource BrushAccentLight}" FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ══ CONTENU ZOMBIES PAR MANCHE ══ -->
    <ScrollViewer x:Name="ZombiesPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="24,20,24,20" MaxWidth="640" HorizontalAlignment="Left">

        <TextBlock Text="ZOMBIES PAR MANCHE"
                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}"
                   Margin="0,0,0,4" />
        <TextBlock Text="Nombre de zombies à tuer à la manche en cours, selon le nombre de joueurs. S'affiche aussi dans l'overlay OBS, en dessous des manches spéciales, et est modifiable directement depuis l'overlay."
                   FontFamily="Consolas" FontSize="12"
                   Foreground="{StaticResource BrushTextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20" />

        <TextBlock Text="NOMBRE DE JOUEURS" Style="{StaticResource SectionLabelStyle}" />
        <Border Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="6"
                Padding="3" Margin="0,0,0,20"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="ZombiesPlayers1Btn" Content="1 JOUEUR" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                              Padding="14,5" Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextSecondary}"
                              BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Cursor="Hand"
                              Click="ZombiesPlayersBtn_Click" />
                <ToggleButton x:Name="ZombiesPlayers2Btn" Content="2 JOUEURS" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                              Padding="14,5" Margin="4,0,0,0" Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextSecondary}"
                              BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Cursor="Hand"
                              Click="ZombiesPlayersBtn_Click" />
                <ToggleButton x:Name="ZombiesPlayers3Btn" Content="3 JOUEURS" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                              Padding="14,5" Margin="4,0,0,0" Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextSecondary}"
                              BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Cursor="Hand"
                              Click="ZombiesPlayersBtn_Click" />
                <ToggleButton x:Name="ZombiesPlayers4Btn" Content="4 JOUEURS" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                              Padding="14,5" Margin="4,0,0,0" Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextSecondary}"
                              BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Cursor="Hand"
                              Click="ZombiesPlayersBtn_Click" />
            </StackPanel>
        </Border>

        <TextBlock Text="MANCHE" Style="{StaticResource SectionLabelStyle}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBox x:Name="ZombiesRoundInput"
                     Width="60" Height="32"
                     FontFamily="Consolas" FontSize="14"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     Background="{StaticResource BrushBgCard}"
                     Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}"
                     BorderThickness="1"
                     Margin="0,0,8,0"
                     MaxLength="4"
                     PreviewTextInput="ZombiesRoundInput_PreviewTextInput" />
            <Button x:Name="ZombiesSetRoundButton" Content="ALLER À" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                    Padding="12,8" Margin="0,0,16,0" Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Cursor="Hand"
                    Click="ZombiesSetRoundButton_Click" />
            <Button x:Name="ZombiesRoundMinusBtn" Content="− 1" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                    Padding="16,8" Background="{StaticResource BrushBgCard}" Foreground="{StaticResource BrushTextPrimary}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Cursor="Hand"
                    Click="ZombiesRoundMinusBtn_Click" />
            <TextBlock x:Name="ZombiesRoundText" Text="1" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource BrushAccentLight}" VerticalAlignment="Center"
                       Margin="18,0,18,0" MinWidth="50" TextAlignment="Center" />
            <Button x:Name="ZombiesRoundPlusBtn" Content="+ 1" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                    Padding="16,8" Background="{StaticResource BrushAccentDark}" Foreground="{StaticResource BrushAccentLight}"
                    BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" Cursor="Hand"
                    Click="ZombiesRoundPlusBtn_Click" />
            <Button x:Name="ZombiesRoundResetBtn" Content="RÉINITIALISER" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                    Padding="12,8" Margin="16,0,0,0" Background="#3D1010" Foreground="#FF6B6B"
                    BorderBrush="#C0392B" BorderThickness="1" Cursor="Hand"
                    Click="ZombiesRoundResetBtn_Click" />
        </StackPanel>

        <Border Background="{StaticResource BrushBgHistory}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="10"
                Padding="20,16" Margin="0,16,0,0"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="ZOMBIES À TUER" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <TextBlock x:Name="ZombiesCountText" Text="—" FontFamily="Consolas" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentLight}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="HORDES" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <TextBlock x:Name="ZombiesHordesText" Text="—" FontFamily="Consolas" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentLight}" />
                </StackPanel>
            </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    </Grid>
</Window>
